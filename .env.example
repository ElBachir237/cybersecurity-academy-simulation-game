# ============================================================
# HORIZON Cyber Academy — Environment Configuration
# ============================================================

# Database
# Optional: if missing, game runs with localStorage only.
# For Vercel + Supabase: get this from your Supabase project settings.
DATABASE_URL=postgresql://user:password@host:5432/horizon_db

# Authentication
# Generate a strong random token for API calls (Bearer token).
# Used by: POST /api/save, POST /api/certificates
API_SECRET_TOKEN=your-secret-token-here

# NextAuth + Google OAuth
# Get these from Google Cloud Console (see AUTH_SETUP.md)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: Public API key (for client-side requests, if needed)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Node environment
NODE_ENV=development